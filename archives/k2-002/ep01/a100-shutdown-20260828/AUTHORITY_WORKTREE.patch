-    extra_diff = [
-        {"pointer": f"/prompt/3/{key}", "expected": value, "actual": history_extra_data.get(key)}
-        for key, value in expected_extra.items()
-        if history_extra_data.get(key) != value
-    ]
-    if extra_diff:
