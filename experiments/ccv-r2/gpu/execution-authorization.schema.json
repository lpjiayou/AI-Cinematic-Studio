{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cinematic-studio.local/schemas/ccv-r2-g2-execution-authorization.schema.json",
  "title": "ACS CCV-R2 G2 Execution Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "governanceCheckpoint",
    "authorizedBy",
    "authorizedAt",
    "gpuExecutionAuthorized",
    "preparationRoot",
    "preparationReceiptSha256",
    "preparationInventorySha256",
    "expectedRunCount",
    "maximumQueueCount",
    "maximumInFlight",
    "automaticRetryAuthorized",
    "resultRoot",
    "comfyUiServer",
    "comfyUiOutputRoot",
    "historyTimeoutSeconds",
    "pollIntervalSeconds",
    "rightsLabels",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ACS-CCV-R2-G2-EXECUTION-AUTHORIZATION-1"
    },
    "governanceCheckpoint": {
      "const": "ACS-CCV-R2-G2-GPU-EXECUTION"
    },
    "authorizedBy": {
      "const": "PROJECT_LEAD"
    },
    "authorizedAt": {
      "type": "string",
      "format": "date"
    },
    "gpuExecutionAuthorized": {
      "const": true
    },
    "preparationRoot": {
      "const": "/data/ccv-r2-2026-08-15-preparation-g1"
    },
    "preparationReceiptSha256": {
      "const": "995035ee1169b7335d7c0707ea6adc31e36cd342c2a281f475fd66b7f4952c05"
    },
    "preparationInventorySha256": {
      "const": "95e1257003b28aced87719d31b4caba2eabc5a18995d2d9b98dbfb20157db40a"
    },
    "expectedRunCount": {
      "const": 45
    },
    "maximumQueueCount": {
      "const": 45
    },
    "maximumInFlight": {
      "const": 1
    },
    "automaticRetryAuthorized": {
      "const": false
    },
    "resultRoot": {
      "const": "/data/ccv-r2-2026-08-15-results-g2"
    },
    "comfyUiServer": {
      "enum": [
        "http://127.0.0.1:8188",
        "http://localhost:8188"
      ]
    },
    "comfyUiOutputRoot": {
      "const": "/data/coding/apps/ComfyUI/output"
    },
    "historyTimeoutSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 7200
    },
    "pollIntervalSeconds": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 10
    },
    "rightsLabels": {
      "type": "array",
      "uniqueItems": true,
      "contains": {
        "const": "SYNTHETIC_TEST_ONLY"
      },
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validationAccepted",
        "productionReady"
      ],
      "properties": {
        "validationAccepted": {
          "const": false
        },
        "productionReady": {
          "const": false
        }
      }
    }
  }
}
