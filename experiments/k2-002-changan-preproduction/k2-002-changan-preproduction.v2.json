        "globalOrder": 2,
        "durationFrames": 60,
        "editorialShotSize": "ECU",
        "actionBeat": "沈知微微调光角，刮痕残笔逐渐浮起。",
        "visibleIdentityBindings": [],
        "dialogueRequirement": {"speaker": "沈知微", "text": "直到刮痕下——", "sourceMode": "NARRATION"},
        "dialogueSyncMode": "OFF_CAMERA_OR_NON_VISIBLE_MOUTH",
        "postprocessRequirements": [{"requirementKey": "residual-scroll-input-continuity", "type": "TRACKED_PROP_INPUT", "inputAssetRequirementKeys": ["residual-scroll-master", "ep01-postprocess-manifest"], "status": "NOT_READY"}]
      },
      {
        "shotKey": "K2-002-EP01-SH03",
        "globalOrder": 3,
        "durationFrames": 48,
        "editorialShotSize": "CU",
        "actionBeat": "镊子缓慢下压，停在纸纤维上方；镜尾以手势和构图匹配切入唐代长案。",
        "visibleIdentityBindings": [],
        "dialogueRequirement": {"speaker": "沈知微", "text": "浮出了一个不该存在的字。", "sourceMode": "NARRATION"},
        "dialogueSyncMode": "OFF_CAMERA_OR_NON_VISIBLE_MOUTH",
        "postprocessRequirements": [{"requirementKey": "modern-restoration-input-continuity", "type": "TRACKED_PROP_INPUT", "inputAssetRequirementKeys": ["residual-scroll-master", "modern-tweezers-action", "ep01-postprocess-manifest"], "status": "NOT_READY"}]
      },
      {
        "shotKey": "K2-002-EP01-SH04",
        "globalOrder": 4,
        "durationFrames": 60,
        "editorialShotSize": "MCU",
        "actionBeat": "唐装沈知微俯身靠近残卷，眉心收紧。",
        "visibleIdentityBindings": [{"characterName": "沈知微", "bindingMode": "FACE_LOCK"}],
        "dialogueRequirement": {"speaker": null, "text": "纸张轻响，呼吸变浅。", "sourceMode": "SFX_OR_SILENCE"},
        "dialogueSyncMode": "NONE",
        "postprocessRequirements": [{"requirementKey": "shen-face-mark-overlay", "type": "TRACKED_IDENTITY_MARK", "inputAssetRequirementKeys": ["shen-face-mark-overlay", "ep01-postprocess-manifest"], "status": "NOT_READY"}]
      },
