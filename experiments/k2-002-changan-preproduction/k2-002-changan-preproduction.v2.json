        "globalOrder": 5,
        "durationFrames": 60,
        "editorialShotSize": "CU",
        "actionBeat": "沈知微主动转动油灯底座，把侧光对准刮痕。",
        "visibleIdentityBindings": [{"characterName": "沈知微", "bindingMode": "BODY_ONLY"}],
        "dialogueRequirement": {"speaker": null, "text": "铜座摩擦木案声。", "sourceMode": "SFX_OR_SILENCE"},
        "dialogueSyncMode": "NONE",
