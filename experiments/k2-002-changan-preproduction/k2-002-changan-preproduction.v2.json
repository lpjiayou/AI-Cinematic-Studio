    "title": "刮痕",
    "recognizedCharacter": "贞",
    "worldChange": "校书房远端一盏油灯永久熄灭",
    "cameraContractState": "NOT_READY",
    "shots": [
      {
        "shotKey": "K2-002-EP01-SH01",
        "globalOrder": 1,
        "durationFrames": 60,
        "editorialShotSize": "ECU",
        "actionBeat": "侧光从右向左扫过残卷纤维。",
        "visibleIdentityBindings": [],
        "dialogueRequirement": {"speaker": "沈知微", "text": "我以为，那只是一份残卷。", "sourceMode": "NARRATION"},
        "dialogueSyncMode": "OFF_CAMERA_OR_NON_VISIBLE_MOUTH",
