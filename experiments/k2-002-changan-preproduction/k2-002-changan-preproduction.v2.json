      },
      {
        "shotKey": "K2-002-EP01-SH06",
        "globalOrder": 6,
        "durationFrames": 48,
        "editorialShotSize": "CU",
        "actionBeat": "灯芯拉出细长暖色火焰，室内底噪骤然变空。",
        "visibleIdentityBindings": [],
        "dialogueRequirement": {"speaker": null, "text": "油灯噼啪停止半拍。", "sourceMode": "SFX_OR_SILENCE"},
        "dialogueSyncMode": "NONE",
