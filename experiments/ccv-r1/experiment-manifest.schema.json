{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cinematic-studio.local/schemas/ccv-r1-experiment-manifest.schema.json",
  "title": "ACS CCV-R1 Experiment Evidence Manifest",
  "description": "EXPERIMENT EVIDENCE / NOT PRODUCTION CODE / NOT A MILESTONE DELIVERABLE / SYNTHETIC_TEST_ONLY / NOT FOR PRODUCTION",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "experimentId",
    "roundId",
    "status",
    "rightsLabels",
    "historicalExecutionDate",
    "manifestCreatedAt",
    "historicalScriptBytesRecovered",
    "hardenedSuccessorScripts",
    "environment",
    "models",
    "artifacts",
    "expectedRunCount",
    "runs",
    "claims"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestVersion": {
      "const": "1.0"
    },
    "experimentId": {
      "const": "acs-ccv-r1"
    },
    "roundId": {
      "enum": ["round-1", "round-2", "round-3", "all-rounds"]
    },
    "status": {
      "enum": [
        "EXPERIMENT_REPORTED_INDEPENDENT_REPRODUCTION_NOT_POSSIBLE",
        "EVIDENCE_CAPTURED_NOT_VALIDATION_ACCEPTED"
      ]
    },
    "rightsLabels": {
      "const": ["SYNTHETIC_TEST_ONLY", "NOT_FOR_PRODUCTION"]
    },
    "historicalExecutionDate": {
      "const": "2026-08-14"
    },
    "manifestCreatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "historicalScriptBytesRecovered": {
      "type": "boolean"
    },
    "hardenedSuccessorScripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileEvidence"
      }
    },
    "environment": {
      "type": "object"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileEvidence"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEvidence"
      }
    },
    "expectedRunCount": {
      "type": "integer",
      "minimum": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runEvidence"
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationAccepted", "independentReproductionPossible", "schemaChangeAuthorized"],
      "properties": {
        "validationAccepted": {
          "const": false
        },
        "independentReproductionPossible": {
          "const": false
        },
        "schemaChangeAuthorized": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileEvidence": {
      "type": "object",
      "required": ["role", "logicalName", "sizeBytes", "sha256"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "logicalName": {
          "type": "string",
          "minLength": 1
        },
        "filePath": {
          "type": ["string", "null"]
        },
        "sizeBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "modelFamily": {
          "type": "string"
        },
        "conditioningDimension": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "licenseStatus": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "roundId",
        "batchId",
        "shotId",
        "parameters",
        "output",
        "runState",
        "failure",
        "retryOfRunId",
        "excluded",
        "exclusionReason"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "roundId": {
          "enum": ["round-1", "round-2", "round-3"]
        },
        "batchId": {
          "type": "string",
          "minLength": 1
        },
        "shotId": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "required": [
            "positivePrompt",
            "negativePrompt",
            "width",
            "height",
            "steps",
            "cfg",
            "sampler",
            "scheduler",
            "seed"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logicalPath", "sizeBytes", "sha256"],
          "properties": {
            "logicalPath": {
              "type": "string",
              "pattern": "^[^/].*\\.png$"
            },
            "sizeBytes": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "runState": {
          "enum": ["PENDING_EXTERNAL_EVIDENCE", "CAPTURED", "FAILED", "EXCLUDED"]
        },
        "failure": {
          "type": ["object", "null"]
        },
        "retryOfRunId": {
          "type": ["string", "null"]
        },
        "excluded": {
          "type": "boolean"
        },
        "exclusionReason": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
