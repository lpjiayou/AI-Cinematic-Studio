        {
          "characterRef": "character-gu-yan-k2-001",
          "name": "顾言",
          "background": "中央记忆档案城的监察人员，长期负责高风险档案的检索与封存。",
          "motivation": "在制度流程失效时仍控制证据外泄并确认异常来源。",
          "belief": "只有能够被独立复核的事实才值得承担责任。",
          "conflict": "职责要求服从档案系统，但亲眼所见与系统判断发生冲突。",
          "goal": "切断外部检索并保存一份可独立验证的摘要。",
          "personality": "审慎、克制、果断，行动先于解释。",
          "behaviorRules": [
            "先建立安全边界，再提供有限信息",
            "关键动作简短明确，不做多余展示"
          ],
          "dialogueRules": [
            "使用短句，语速稳定，避免情绪宣泄",
            "只陈述可执行规则或已经核验的事实"
          ],
          "forbiddenBehavior": [
            "不得在没有证据时无条件相信林澈",
            "不得用夸张肢体动作或高声威胁替代判断"
          ],
          "visualIdentityRules": [
            "灰白短发，发际线与轮廓固定",
            "深灰监察制服",
            "胸前上部一枚小型琥珀身份灯，位置不得漂移"
          ],
          "locationRefs": [
            "location-central-memory-archive-outer-bridge",
            "location-central-memory-archive-verification-bay"
          ],
          "propRefs": [
            "prop-anomalous-memory-shard",
