      "worldRules": [
        {
          "worldRuleRef": "world-rule-independent-memory-verification",
          "statement": "记忆档案的存在性判断不能替代独立校验；判断冲突时必须保存可复核摘要。"
        },
        {
          "worldRuleRef": "world-rule-residual-verification-trace",
          "statement": "可见记录被删除后仍可能保留校验痕迹；校验痕迹必须与原始内容分别表述。"
        }
